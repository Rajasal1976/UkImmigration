---
// Top bar, logo and menus. Menus are built from the pages in the admin (src/data/nav.js).
import { site } from '../data/site.js';
import { menu } from '../data/nav.js';
---
<div class="topbar" role="note"><div class="wrap topbar-row"><span><strong>Regulated by the Immigration Advice Authority</strong> · Ref {site.iaaRef} · Part of {site.groupName}</span><span class="topbar-contact">{site.hours} · <a href={`tel:${site.phoneIntl}`}>{site.phone}</a></span></div></div>
<header class="header">
  <div class="wrap header-row">
    <a class="brand" href="/" aria-label={`${site.name}, home`}><img src={site.logo} alt="" width="62" height="62" /><span class="brand-name">UK Immigration<small>Advisory</small></span></a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="main-nav">Menu</button>
    <nav id="main-nav" class="nav" aria-label="Main">
      {menu.map((m) => m.items.length ? (
        <div class="dd">
          <a href={m.href} aria-haspopup="true">{m.label} <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2.5 4.5 6 8l3.5-3.5"/></svg></a>
          <ul class="dd-menu">{m.items.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
        </div>
      ) : <a href={m.href}>{m.label}</a>)}
      <a class="btn btn-gold" href={site.bookingUrl}>Book a consultation</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('main-nav');
  btn?.addEventListener('click', () => {
    const open = nav!.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
