---
// Homepage, as approved in the design mock. Text is edited in the admin under Homepage.
// The service cards link to the pages chosen in the admin, so they always lead to a real page.
import Page from '../layouts/Page.astro';
import Flow from '../components/Flow.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import AbsenceCalculator from '../components/AbsenceCalculator.astro';
import home from '../../content/home.json';
import { site } from '../data/site.js';
import { pageBySlug, navName } from '../data/pages.js';
import { svg } from '../data/icons.js';
import { inline } from '../lib/inline.js';
// The words in "gold italic words" are picked out within the main heading
const esc = (t = '') => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
const accent = (h, a) => (a && h.includes(a) ? esc(h).replace(esc(a), `<em>${esc(a)}</em>`) : esc(h));
const services = (home.services || []).map((s) => ({ ...s, page: pageBySlug[s.page] })).filter((s) => s.page);
---
<Page title={home.title} description={home.description} crumbs={[]}>
  <main>
    <section class="home-hero"><div class="wrap">
      <div>
        <span class="kicker">{home.heroEyebrow}</span>
        <h1 set:html={accent(home.heroHeading, home.heroAccent)} />
        <p class="lead">{home.heroIntro}</p>
        <div class="btn-row"><a class="btn btn-gold" href={site.bookingUrl}>Book a consultation</a><a class="btn btn-ghost-light" href="/absence-calculator/">Check your absences</a></div>
      </div>
      <aside class="card-float">
        <h2>{home.cardTitle}</h2>
        <p>{home.cardText}</p>
        <ul class="rule-list">{(home.cardRules || []).map((r) => <li><span>{r.label}</span><b>{r.value}</b></li>)}</ul>
        <a class="btn btn-gold" href="#absence" style="width:100%">Use the absence calculator</a>
      </aside>
    </div></section>

    <section class="trust-line" aria-label="Why clients trust us"><div class="wrap">
      {(home.trust || []).map((t) => <div><strong>{t.title}</strong>{t.text}</div>)}
    </div></section>

    <section class="section tinted" id="services"><div class="wrap">
      <div class="section-head"><span class="kicker">How we can help</span><h2>{home.servicesTitle}</h2><p>{home.servicesIntro}</p></div>
      <div class="services">
        {services.map((s) => <a class="service" href={`/${s.page.slug}/`}><span style="margin:0;color:var(--gold-text)" set:html={svg(s.icon, 26)} /><h3>{s.title || navName(s.page)}</h3><p>{s.text || s.page.cardText}</p><span>Find out more</span></a>)}
      </div>
    </div></section>

    <section class="section" id="absence"><div class="wrap">
      <div class="section-head"><span class="kicker">Free tool</span><h2>Absence calculator</h2><p>{home.calculatorIntro}</p></div>
      <AbsenceCalculator />
    </div></section>

    <Flow />

    <section class="navy-band" id="about"><div class="wrap">
      <img src={site.logo} alt="" width="130" height="130" loading="lazy" />
      <div><span class="kicker">Our parent company</span><h2>{home.parentTitle}</h2><p set:html={inline(home.parentText)} /></div>
      <a class="btn" href={site.iaaFinder} target="_blank" rel="noopener">Check our IAA registration</a>
    </div></section>

    {home.sections?.length > 0 && (
      <section class="section"><div class="wrap content">
        {home.sections.map((s) => <section><h2>{s.heading}</h2>{s.text.split(/\n\s*\n/).map((t) => <p set:html={inline(t)} />)}</section>)}
      </div></section>
    )}

    <section class="section tinted"><div class="wrap"><Faq items={home.faqs} title="Frequently asked questions" /></div></section>
    <CtaBand />
  </main>
</Page>
